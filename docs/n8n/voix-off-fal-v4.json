    {
      "parameters": {
        "sendTo": "={{ $('Préparer la voix off').first().json.destinataire }}",
        "subject": "Voix off prête (Eleven v4) : La grande accélération",
        "emailType": "text",
        "message": "=Bonjour,\n\nLa voix off de « La grande accélération » est prête (ElevenLabs Eleven v4 Turbo, voix {{ $('Préparer la voix off').first().json.voix }}).\n\nEn pièces jointes :\n- l'audio de la voix off ;\n- minutage-voix-off.json : la réponse complète de fal, avec le minutage de chaque mot.\n\nLien direct fal : {{ $json.audio_url }}\n",
        "options": {
          "appendAttribution": false,
          "attachmentsUi": {
            "attachmentsBinary": [
              {
                "property": "voix"
              },
              {
                "property": "minutage"
              }
            ]
          }
        }
      },

    {
      "parameters": {
        "jsCode": "// Le résultat fal contient l'URL de l'audio et, avec timestamps: true, le minutage de chaque mot.\n// On le joint en fichier JSON à côté de l'audio : il sert à caler la vidéo au mot près.\nconst resultat = $('Récupérer la voix générée').first().json;\nconst item = $input.first();\nconst minutage = JSON.stringify(resultat, null, 2);\nitem.binary = item.binary || {};\nitem.binary.minutage = await this.helpers.prepareBinaryData(\n  Buffer.from(minutage, 'utf8'),\n  'minutage-voix-off.json',\n  'application/json'\n);\nitem.json = {\n  audio_url: resultat.audio?.url,\n  taille_octets: resultat.audio?.file_size ?? null,\n  mots_horodates: Array.isArray(resultat.timestamps) ? resultat.timestamps.length : null\n};\nreturn [item];"
      },
      "id": "750fe8ed-99f5-4b4f-b213-3400ffb11bd3",
      "name": "Joindre le minutage des mots",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        -120

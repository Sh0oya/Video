        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.texte, voice: $json.voix, language_code: 'fr', stability: 0.5, similarity_boost: 0.8, apply_text_normalization: 'auto', timestamps: true }) }}"

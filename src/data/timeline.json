   "from": 760,
   "duration": 483,
   "lines": [
    {
     "from": 772,
     "to": 872,
     "subs": [
      {
       "text": "Après un plateau,",
       "from": 772,
       "to": 803
      },
      {
       "text": "les installations repartent de plus belle.",
       "from": 803,
       "to": 872
      }
     ],
     "key": "l0"
    },
    {
     "from": 881,
     "to": 1078,
     "subs": [
      {
       "text": "En 2025, nouveau record :",
       "from": 881,
       "to": 951
      },
      {
       "text": "plus de 600 000 robots,",
       "from": 951,
       "to": 998
      },
      {
       "text": "en hausse de 11 %, bien plus que prévu.",
       "from": 998,
       "to": 1078
      }
     ],
     "key": "l1"
    },
    {
     "from": 1087,
     "to": 1222,
     "subs": [
      {
       "text": "Soit plus de 1 600 par jour, en moyenne.",
       "from": 1087,
       "to": 1175
      },
      {
       "text": "Plus d’un robot chaque minute.",
       "from": 1175,
       "to": 1222
      }
     ],
     "key": "l2"
    }
   ]
  },
  {
   "id": "quote",
   "from": 1243,
   "duration": 381,
   "lines": [
    {
     "from": 1258,
     "to": 1452,
     "subs": [
      {
       "text": "« L’automatisation industrielle progresse à grande vitesse »,",
       "from": 1258,
       "to": 1366
      },
      {
       "text": "résume Jane Heffner,",
       "from": 1366,
       "to": 1407
      },
      {
       "text": "présidente de la fédération.",
       "from": 1407,
       "to": 1452
      }
     ],
     "key": "l0"
    },
    {
     "from": 1466,
     "to": 1600,
     "subs": [
      {
       "text": "L’Asie fonce,",
       "from": 1466,
       "to": 1493
      },
      {
       "text": "suivie des Amériques.",
       "from": 1493,
       "to": 1531
      },
      {
       "text": "L’Europe, elle, avance plus lentement.",
       "from": 1531,
       "to": 1600
      }
     ],
     "key": "l1"
    }
   ]
  },
  {
   "id": "china",
   "from": 1624,
   "duration": 348,
   "lines": [
    {
     "from": 1636,
     "to": 1814,
     "subs": [

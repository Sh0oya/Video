      {
       "text": "la Chine installe neuf fois plus de robots",
       "from": 2845,
       "to": 2907
      },
      {
       "text": "que les États-Unis.",
       "from": 2907,
       "to": 2940
      }
     ],
     "key": "l0"
    },
    {
     "from": 2953,
     "to": 3077,
     "subs": [
      {
       "text": "Quatrième, la Corée du Sud.",
       "from": 2953,
       "to": 3006
      },
      {
       "text": "Cinquième, l’Allemagne, premier marché européen.",
       "from": 3006,
       "to": 3077

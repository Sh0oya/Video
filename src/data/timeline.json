       "to": 3420
      },
      {
       "text": "la logistique,",
       "from": 3420,
       "to": 3447
      },
      {
       "text": "le médical.",
       "from": 3447,
       "to": 3474
      },
      {
       "text": "La relocalisation devrait les porter, selon la fédération.",
       "from": 3474,
       "to": 3565
      }
     ],
     "key": "l2"
    }
   ]
  },

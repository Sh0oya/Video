     "key": "l2"
    }
   ]
  },
  {
   "id": "quote",
   "from": 1337,
   "duration": 391,
   "lines": [
    {
     "from": 1358,
     "to": 1559,
     "subs": [
      {
       "text": "« L’automatisation industrielle progresse à grande vitesse »,",
       "from": 1358,
       "to": 1468
      },
      {
       "text": "résume Jane Heffner,",
       "from": 1468,
       "to": 1512
      },
      {
       "text": "présidente de la fédération.",
       "from": 1512,
       "to": 1559
      }
     ],
     "key": "l0"
    },
    {
     "from": 1577,
     "to": 1692,
     "subs": [
      {
       "text": "L’Asie fonce,",
       "from": 1577,
       "to": 1599
      },
      {
       "text": "suivie des Amériques.",
       "from": 1599,
       "to": 1634
      },
      {
       "text": "L’Europe, elle, avance plus lentement.",
       "from": 1634,
       "to": 1692
      }
     ],
     "key": "l1"
    }
   ]
  },
  {
   "id": "china",
   "from": 1728,
   "duration": 367,
   "lines": [
    {
     "from": 1746,
     "to": 1912,
     "subs": [

       "to": 3565
      }
     ],
     "key": "l0"
    },
    {
     "from": 3580,
     "to": 3680,
     "subs": [
      {
       "text": "La fédération y voit aussi un atout de compétitivité.",
       "from": 3580,
       "to": 3680
      }
     ],
     "key": "l1"
    },
    {
     "from": 3695,
     "to": 3967,
     "subs": [
      {
       "text": "Aux États-Unis, les robots se multiplient",
       "from": 3695,
       "to": 3761
      },
      {
       "text": "dans l’agroalimentaire,",
       "from": 3761,
       "to": 3805
      },
      {
       "text": "la logistique,",
       "from": 3805,
       "to": 3829
      },
      {
       "text": "le médical.",
       "from": 3829,
       "to": 3864
      },
      {
       "text": "La relocalisation devrait les porter, selon la fédération.",
       "from": 3864,
       "to": 3967
      }
     ],
     "key": "l2"
    }
   ]
  },

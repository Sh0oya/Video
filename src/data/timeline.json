      {
       "text": "et deviennent le deuxième marché mondial.",
       "from": 2364,
       "to": 2439
      }
     ],
     "key": "l0"
    },
    {
     "from": 2452,
     "to": 2574,
     "subs": [
      {
       "text": "Environ 38 400 nouveaux robots,",
       "from": 2452,
       "to": 2532
      },
      {
       "text": "en hausse de 12 %.",
       "from": 2532,
       "to": 2574
      }
     ],
     "key": "l1"
    },
    {
     "from": 2588,
     "to": 2713,
     "subs": [
      {
       "text": "Le Japon, lui, chute de 19 %",
       "from": 2588,
       "to": 2671
      },
      {
       "text": "et recule à la troisième place.",
       "from": 2671,
       "to": 2713
      }
     ],
     "key": "l2"
    }
   ]
  },
  {
   "id": "ranking",
   "from": 2743,
   "duration": 633,
   "lines": [
    {
     "from": 2761,
     "to": 2940,
     "subs": [

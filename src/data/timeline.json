   "from": 1294,
   "duration": 452,
   "lines": [
    {
     "from": 1315,
     "to": 1516,
     "subs": [
      {
       "text": "« L’automatisation industrielle progresse à grande vitesse »,",
       "from": 1315,
       "to": 1425
      },
      {
       "text": "résume Jane Heffner,",
       "from": 1425,
       "to": 1469
      },
      {
       "text": "présidente de la fédération.",
       "from": 1469,
       "to": 1516
      }
     ],
     "key": "l0"
    },
    {
     "from": 1534,
     "to": 1710,
     "subs": [
      {
       "text": "C’est en Asie que la croissance est la plus forte,",
       "from": 1534,
       "to": 1610
      },
      {
       "text": "devant les Amériques.",
       "from": 1610,
       "to": 1644
      },
      {
       "text": "L’Europe, elle, avance plus lentement.",
       "from": 1644,
       "to": 1710
      }
     ],
     "key": "l1"
    }
   ]
  },
  {
   "id": "china",
   "from": 1746,
   "duration": 487,
   "lines": [
    {
     "from": 1764,
     "to": 1852,
     "subs": [
      {
       "text": "Premier marché mondial, la Chine creuse encore l’écart.",

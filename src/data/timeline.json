       "to": 1852
      }
     ],
     "key": "l0"
    },
    {
     "from": 1865,
     "to": 1994,
     "subs": [
      {
       "text": "Elle a installé plus de 350 000 robots,",
       "from": 1865,
       "to": 1956
      },
      {
       "text": "un bond de 20 %.",
       "from": 1956,
       "to": 1994
      }
     ],
     "key": "l1"
    },
    {
     "from": 2008,
     "to": 2197,
     "subs": [
      {
       "text": "Cela représente 59 % des installations de la planète.",
       "from": 2008,
       "to": 2131
      },
      {
       "text": "Près de trois nouveaux robots sur cinq.",
       "from": 2131,
       "to": 2197
      }
     ],
     "key": "l2"
    }
   ]
  },
  {
   "id": "usajapan",
   "from": 2233,
   "duration": 510,
   "lines": [
    {
     "from": 2251,
     "to": 2439,
     "subs": [
      {
       "text": "Derrière, le podium bascule :",

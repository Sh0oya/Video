     "from": 4493,
     "to": 4732,
     "subs": [
      {
       "text": "Aujourd’hui, 5 millions de robots.",
       "from": 4493,
       "to": 4555
      },
      {
       "text": "En 2029, plus de 800 000 installations prévues.",
       "from": 4555,
       "to": 4664
      },
      {
       "text": "Le monde se robotise à une vitesse folle.",
       "from": 4664,
       "to": 4732
      }

   "lines": [
    {
     "from": 579,
     "to": 680,
     "subs": [
      {
       "text": "En un an, le parc mondial",
       "from": 579,
       "to": 627
      },
      {
       "text": "a encore grimpé de 9 %.",
       "from": 627,
       "to": 680
      }
     ],
     "key": "l0"
    },
    {
     "from": 689,
     "to": 733,
     "subs": [

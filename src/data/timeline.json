       "to": 3984
      },
      {
       "text": "en hausse de 9 %.",
       "from": 3984,
       "to": 4026
      }
     ],
     "key": "l1"
    },
    {
     "from": 4036,
     "to": 4227,
     "subs": [
      {
       "text": "Puis 806 000 attendues pour 2029 :",
       "from": 4036,
       "to": 4139
      },
      {
       "text": "un bond d’environ un tiers, en quatre ans à peine.",
       "from": 4139,
       "to": 4227
      }

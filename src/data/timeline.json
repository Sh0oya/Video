  {
   "id": "quote",
   "from": 1212,
   "duration": 344,
   "lines": [
    {
     "from": 1227,
     "to": 1394,
     "subs": [
      {
       "text": "« L’automatisation industrielle progresse à grande vitesse »,",
       "from": 1227,
       "to": 1314
      },
      {
       "text": "résume Jane Heffner,",
       "from": 1314,
       "to": 1352
      },
      {
       "text": "présidente de la fédération.",
       "from": 1352,
       "to": 1394
      }
     ],
     "key": "l0"
    },
    {
     "from": 1408,
     "to": 1532,
     "subs": [
      {
       "text": "L’Asie fonce,",
       "from": 1408,
       "to": 1437
      },
      {
       "text": "suivie des Amériques.",
       "from": 1437,
       "to": 1467
      },
      {
       "text": "L’Europe, elle, avance plus lentement.",
       "from": 1467,
       "to": 1532
      }
     ],
     "key": "l1"
    }
   ]
  },
  {

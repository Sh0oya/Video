       "from": 1757,
       "to": 1832
      },
      {
       "text": "Près de trois nouveaux robots sur cinq.",
       "from": 1832,
       "to": 1893
      }
     ],
     "key": "l1"
    }
   ]
  },
  {
   "id": "usajapan",
   "from": 1917,
   "duration": 277,
   "lines": [
    {
     "from": 1929,
     "to": 2097,
     "subs": [
      {
       "text": "Derrière, le podium bascule :",

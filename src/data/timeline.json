  },
  {
   "id": "outro",
   "from": 4260,
   "duration": 718,
   "lines": [
    {
     "from": 4275,
     "to": 4525,
     "subs": [
      {
       "text": "Aujourd’hui, 5 millions de robots.",
       "from": 4275,
       "to": 4340
      },
      {
       "text": "En 2029, plus de 800 000 installations prévues.",
       "from": 4340,
       "to": 4444
      },
      {
       "text": "Le monde se robotise à une vitesse folle.",
       "from": 4444,
       "to": 4525
      }
     ],
     "key": "l0"
    },
    {
     "from": 4537,
     "to": 4822,
     "subs": [
      {
       "text": "Bien accompagnée, cette révolution peut être une chance :",
       "from": 4537,
       "to": 4635
      },
      {
       "text": "moins de tâches pénibles, de nouveaux métiers.",
       "from": 4635,
       "to": 4718
      },
      {
       "text": "La vitesse, on ne la choisit pas.",
       "from": 4718,
       "to": 4780
